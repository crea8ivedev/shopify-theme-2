{{ 'component-marquee.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-marquee.js' | asset_url }}" defer="defer"></script>

{%- style -%}
    .section-{{ section.id }}-padding {
      padding-left: 20px;
      padding-right: 20px;
      padding-top: calc({{ section.settings.padding_top }}px * 0.75);
      padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
    }
  
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient" role="region" aria-label="Image Gallery">
    <div class="section-{{ section.id }}-padding">
        {% if section.blocks.size > 0 %}
        <div class="marquee-images">
            <div class="swiper marquee-swiper" aria-live="polite">
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                    <div class="image swiper-slide" role="listitem">
                        {% if block.settings.logo_image != '' %}
                            <img src="{{ block.settings.logo_image | image_url }}" 
                                 alt="Brand Logo Image" 
                                 height="auto" width="auto" loading="lazy">
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>

<script>
  window.swiperSettings = {
    marquee_breakpoint_mobile: {{ section.settings.marquee_breakpoint_mobile }},
    marquee_breakpoint_tablet: {{ section.settings.marquee_breakpoint_tablet }},
    marquee_breakpoint_desktop: {{ section.settings.marquee_breakpoint_desktop }},
    autoplay: {{ section.settings.enable_autoplay }}
  };
</script>

{% schema %}
{
  "name": "Marquee",
  "class": "maquee-main",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.marquee.settings.section_padding"
    },
    {
      "type": "range",
      "label": "t:sections.marquee.settings.padding_top",
      "id": "padding_top",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 10
    },
    {
      "type": "range",
      "label": "t:sections.marquee.settings.padding_bottom",
      "id": "padding_bottom",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 10
    },
    {
      "type": "header",
      "content": "t:sections.marquee.settings.color_scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.marquee.settings.swiper_settings"
    },
    {
        "type": "checkbox",
        "label": "t:sections.marquee.settings.enable_autoplay",
        "id": "enable_autoplay",
        "default": true
    },
    {
      "type": "range",
      "label": "t:sections.marquee.settings.marquee_breakpoint_desktop",
      "id": "marquee_breakpoint_desktop",
      "default": 8,
      "min": 0,
      "max": 10,
      "step": 1
    },
    {
      "type": "range",
      "label": "t:sections.marquee.settings.marquee_breakpoint_tablet",
      "id": "marquee_breakpoint_tablet",
      "default": 7,
      "min": 0,
      "max": 10,
      "step": 1
    },
    {
      "type": "range",
      "label": "t:sections.marquee.settings.marquee_breakpoint_mobile",
      "id": "marquee_breakpoint_mobile",
      "default": 3,
      "min": 0,
      "max": 10,
      "step": 1
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.marquee.blocks.image.name",
      "settings": [
        {
          "type": "image_picker",
          "label": "t:sections.marquee.blocks.image.settings.logo_image",
          "id": "logo_image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.marquee.presets.name"
    }
  ]
}
{% endschema %}
