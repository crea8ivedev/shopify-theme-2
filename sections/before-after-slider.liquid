{{ 'component-before-after-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-before-after-slider.js' | asset_url }}" defer></script>

<section
  id="{{ section.id }}"
  class="before-after-main section-before-after color-{{ section.settings.color_scheme }} background gradient"
>
  <div class="mySwiper swiper before-after-swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div
          id="{{ block.id }}"
          class="before-after-section swiper-slide {% if block.settings.content_alignment_desktop == 'center' %}text-center--desktop {% else %}text-left--desktop {% endif %} {% if block.settings.content_alignment_mobile == 'center' %}text-center--mobile {% else %}text-left--mobile {% endif %}"
        >
          <div class="left-content">
            {% if block.settings.heading != blank %}
              <h5>{{ block.settings.heading }}</h5>
            {% endif %}
            {% if block.settings.sub_heading != blank %}
              <h2>{{ block.settings.sub_heading }}</h2>
            {% endif %}
            {% if block.settings.content != blank %}
              <p>{{ block.settings.content }}</p>
            {% endif %}
            {% if block.settings.button_text != blank %}
              <a
                href="{{ block.settings.button_link }}"
                class="button before-after-shop-btn"
              >
                {{- block.settings.button_text -}}
                {% render 'icon-up-arrow' %}
              </a>
            {% endif %}
          </div>
          <div class="right-content">
            <div class="slider-image before">
              {% if block.settings.before_image != blank %}
                <img
                  src="{{ block.settings.before_image | image_url }}"
                  alt="Before Image"
                  loading="lazy"
                  width="500"
                  height="500"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="slider-image after">
              {% if block.settings.after_image != blank %}
                <img
                  src="{{ block.settings.after_image | image_url }}"
                  alt="After Image"
                  loading="lazy"
                  width="500"
                  height="500"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="before-after-slider-handle" style="left: {{ section.settings.drag_initial_position }}%;">
              <div class="before-after-drag-text"><span>Drag</span></div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="swiper-pagination"></div>
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
  </div>
</section>

<style>
  #{{ section.id }} .slider-image.before {
    z-index: 2;
    clip-path: polygon(0 0, {{ section.settings.drag_initial_position }}% 0, {{ section.settings.drag_initial_position }}% 100%, 0% 100%);
  }
  #{{ section.id }} .before-after-slider-handle {
    position: absolute;
    top: 0;
    left: {{ section.settings.drag_initial_position }}%;
    width: 5px;
    height: 100%;
    background-color: white;
    cursor: ew-resize;
    z-index: 3;
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>

{% schema %}
{
  "name": "Before After Slider",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "drag_initial_position",
      "label": "t:sections.image-with-text.settings.layout.label",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "type": "select",
      "label": "t:sections.image-with-text.settings.desktop_content_position.label",
      "id": "text_position",
      "options": [
        {
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__1.label",
          "value": "top"
        },
        {
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__3.label",
          "value": "bottom"
        }
      ],
      "default": "top"
    }
  ],
  "blocks": [
    {
      "type": "before_after_block",
      "name": "Before After block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.slideshow.blocks.slide.settings.heading.label",
          "default": "Experience the magic before & after with Aura Beauty"
        },
        {
          "type": "html",
          "id": "sub_heading",
          "label": "t:sections.all.subheading.label",
          "default": "Transform Your Look Before and After with Aura Beauty"
        },
        {
          "type": "text",
          "id": "content",
          "label": "t:sections.image-banner.settings.content.content"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "t:sections.slideshow.blocks.slide.settings.button_label.label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.slideshow.blocks.slide.settings.link.label"
        },
        {
          "type": "select",
          "id": "content_alignment_desktop",
          "label": "t:sections.all.text_alignment.label",
          "options": [
            {
              "label": "t:sections.all.text_alignment.options_1.label",
              "value": "left"
            },
            {
              "label": "t:sections.all.text_alignment.options_2.label",
              "value": "center"
            }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "content_alignment_mobile",
          "label": "t:sections.all.text_alignment.label",
          "options": [
            {
              "label": "t:sections.all.text_alignment.options_1.label",
              "value": "left"
            },
            {
              "label": "t:sections.all.text_alignment.options_2.label",
              "value": "center"
            }
          ],
          "default": "left"
        },
        {
          "type": "image_picker",
          "id": "before_image",
          "label": "Before Image"
        },
        {
          "type": "image_picker",
          "id": "after_image",
          "label": "After Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Before After Slider",
      "blocks": [
        {
          "type": "before_after_block"
        },
        {
          "type": "before_after_block"
        },
        {
          "type": "before_after_block"
        }
      ]
    }
  ]
}
{% endschema %}
