{{ 'placeholder.css' | asset_url | stylesheet_tag }}

{% assign placeholder_images = '' %}
{% assign placeholder_videos = '' %}

{% if class contains 'product-placeholder' %}
  {% assign placeholder_images = 'product-placeholder.jpg, product-placeholder1.jpg, product-placeholder2.jpg, product-placeholder3.jpg' %}
{% elsif class contains 'collection-placeholder' %}
  {% assign placeholder_images = 'collection-placeholder.jpg' %}
{% elsif class contains 'header-placeholder' %}
  {% assign placeholder_images = 'header-placeholder.png, header-placeholder.png, header-placeholder.png, header-placeholder.png, header-placeholder.png' %}
{% elsif class contains 'login-placeholder' %}
  {% assign placeholder_images = 'login-placeholder.jpg' %}
{% elsif class contains 'register-placeholder' %}
  {% assign placeholder_images = 'register-placeholder.jpg' %}
{% elsif class contains 'slideshow-placeholder' %}
  {% assign placeholder_images = 'slideshow-placeholder.png' %}
{% elsif class contains 'slideshow-video-placeholder' %}
  {% assign placeholder_videos = 'slideshow-video-placeholder.mp4' %}
{% else %}
  {% assign placeholder_images = 'default-placeholder.jpg' %}
{% endif %}

{% assign images_array = placeholder_images | split: ', ' %}

{% for image in images_array %}
  <img
    src="{{ image | asset_img_url: '600x600' }}"
    srcset="
      {{ image | asset_img_url: '600x600' }} 1x,
      {{ image | asset_img_url: '900x900' }} 2x,
      {{ image | asset_img_url: '1200x1200' }} 3x
    "
    sizes="(max-width: 600px) 100vw, 600px"
    alt="Placeholder Image"
    class="{{ class }}"
    width="600"
    height="600"
  >
{% endfor %}

{% assign videos_array = placeholder_videos | split: ', ' %}

{% for video in videos_array %}
  <video src="{{ video | asset_url }}" class="{{ class }}" width="600" height="600"></video>
{% endfor %}
