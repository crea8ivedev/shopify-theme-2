<div class="countdown-sale-time">
  <h3 id="sale-title">{{ block.settings.sale_text }}</h3>
  <div id="countdown">
    <ul class="countdown-timer">
      <li><span id="days"></span>Days</li>
      <li><span id="hours"></span>Hrs</li>
      <li><span id="minutes"></span>Mins</li>
      <li><span id="seconds"></span>Secs</li>
    </ul>
  </div>
</div>

<style>
  .countdown-timer li {
    display: flex;
    list-style-type: none;
  }
  .countdown-sale-time {
    text-align: center;
    padding: 10px;
    background-color: #ffe7e7;
    border-style: dashed;
    border-width: 2px;
    border-radius: 14px;
    border-color: #944e63;
  }
  .countdown-timer {
    display: flex;
    gap: 20px;
    padding-inline-start: 0px;
    justify-content: center;
  }
  .countdown-timer li span {
    display: block;
  }
</style>

<script>
  (function () {
    const second = 1000,
      minute = second * 60,
      hour = minute * 60,
      day = hour * 24;

    let liquidDate = '{{ block.settings.date }}';
    let [yearFromLiquid, monthFromLiquid, dayFromLiquid] = liquidDate.split('-');

    let today = new Date(),
      dd = String(today.getDate()).padStart(2, '0'),
      mm = String(today.getMonth() + 1).padStart(2, '0'),
      yyyy = today.getFullYear(),
      nextYear = yyyy + 1,
      dayMonth = `${monthFromLiquid}/${dayFromLiquid}/`,
      countdown = dayMonth + yyyy;
    today = mm + '/' + dd + '/' + yyyy;
    if (today > countdown) {
      countdown = dayMonth + nextYear;
    }
    const countDown = new Date(countdown).getTime(),
      x = setInterval(function () {
        const now = new Date().getTime(),
          distance = countDown - now;
        (document.getElementById('days').innerText = Math.floor(distance / day)),
          (document.getElementById('hours').innerText = Math.floor((distance % day) / hour)),
          (document.getElementById('minutes').innerText = Math.floor((distance % hour) / minute)),
          (document.getElementById('seconds').innerText = Math.floor((distance % minute) / second));

        if (distance < 0) {
          document.getElementById('countdown').style.display = 'none';
          document.getElementById('content').style.display = 'block';
          clearInterval(x);
        }
      }, 0);
  })();
</script>
