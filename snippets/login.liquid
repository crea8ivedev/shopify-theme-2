{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="customer login">
  <h2>Log in</h2>
  <div class="drawer_reset_area hidden">
    <h2
      id="drawer_recover"
      tabindex="-1"
      class="font-heading font-bold text-24 leading-31 capitalize text-brown text-center pb-15 m-0"
    >
      Reset your password
    </h2>

    <div class="reset-password">
      <p class="font-body font-normal text-16 leading-26 text-brown !m-0 !py-0 border-0 text-center">
        We will send you an email to reset your password
      </p>

      {%- form 'recover_customer_password' -%}
        {% assign recover_success = form.posted_successfully? %}
        <div class="field border border-solid border-body rounded-4 focus:!shadow-none focus:!outline-0 overflow-hidden">
          <input
            type="email"
            value=""
            name="email"
            id="RecoverEmail"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="off"
            {% if form.errors %}
              aria-invalid="true" aria-describedby="RecoverEmail-email-error" autofocus
            {% endif %}
            placeholder="Email"
            class="!font-body !text-body !text-16 !leading-26"
          >
          <label for="RecoverEmail" class="italic"> Email </label>
        </div>
        {%- if form.errors -%}
          <small id="RecoverEmail-email-error" class="form__message">
            <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 13 13">
              <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2" />
              <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7" />
              <path
                d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z"
                fill="white" />
              <path
                d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z"
                fill="white" stroke="#EB001B" stroke-width="0.7">
            </svg>
            {{ form.errors.messages.form }}
          </small>
        {%- endif -%}

        <button
          class="brown-btn !my-20 w-fit font-body !pt-10 !pb-7 !px-20 !font-semibold !bg-brown !text-white !border !border-solid !border-brown !rounded-4 !text-16 !leading-26 !tracking-normal text-center flex flex-col items-center capitalize cursor-pointer transition-all duration-300 ease-in-out relative hover:!bg-transparent hover:!text-brown"
        >
          Submit
        </button>

        <a
          href="#login"
          id="recover-cancel"
          class="reset-cancel text-center font-body font-semibold !text-16 leading-24 !text-brown !no-underline transition-all duration-300 hover:text-brown_100 !mx-auto !block"
        >
          Cancel
        </a>
      {%- endform -%}
    </div>
  </div>

  <div class="login-cta reset-below-btn">
    {%- if recover_success == true -%}
      <h3 class="form__message" tabindex="-1" autofocus>
        <svg class="hidden" aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 13 13">
          <path
            d="M6.5 12.35C9.73087 12.35 12.35 9.73086 12.35 6.5C12.35 3.26913 9.73087 0.65 6.5 0.65C3.26913 0.65 0.65 3.26913 0.65 6.5C0.65 9.73086 3.26913 12.35 6.5 12.35Z"
            fill="#428445" stroke="white" stroke-width="0.7" />
          <path d="M5.53271 8.66357L9.25213 4.68197" stroke="white" />
          <path d="M4.10645 6.7688L6.13766 8.62553" stroke="white">
        </svg>
        We've sent you an email with a link to update your password.
      </h3>
    {%- endif -%}
    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <h2 class="form__message !mb-10" tabindex="-1" autofocus>
          <span class="visually-hidden"> </span>
          <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 13 13">
            <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2" />
            <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7" />
            <path
              d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z"
              fill="white" />
            <path
              d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z"
              fill="white" stroke="#EB001B" stroke-width="0.7">
          </svg>
          Please adjust the following:
        </h2>
        {{ form.errors | default_errors }}
      {%- endif -%}

      <div class="field border border-solid border-body rounded-4 focus:!shadow-none focus:!outline-0 overflow-hidden">
        <input
          type="email"
          name="customer[email]"
          id="CustomerEmail"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          {% if form.errors contains 'form' %}
            aria-invalid="true"
          {% endif %}
          placeholder="Email"
          class="!font-body !text-body !text-16 !leading-26"
        >
        <label for="CustomerEmail" class="italic"> Email Address or Mobile Number </label>
      </div>

      {%- if form.password_needed -%}
        <div class="field border border-solid border-body rounded-4 focus:!shadow-none focus:!outline-0 overflow-hidden">
          <input
            type="password"
            value=""
            name="customer[password]"
            id="CustomerPassword"
            autocomplete="off"
            {% if form.errors contains 'form' %}
              aria-invalid="true"
            {% endif %}
            placeholder="Password"
            class="!font-body !text-body !text-16 !leading-26"
          >
          <label for="CustomerPassword" class="italic"> Password </label>
        </div>
      {%- endif -%}
      <a
        href="/account/login#recover"
        id="login-none"
        class="drawer_reset_btn text-center font-body font-semibold !text-16 leading-26 !text-brown !no-underline transition-all duration-300 hover:!text-brown_100 hover:no-underline !mx-auto !block"
      >
        Forgot password?
      </a>
      <button
        class="brown-btn"
      >
        Login {{ 'icon-button-arrow.svg' | inline_asset_content }}
      </button>
    {%- endform -%}
  </div>
  <div class="login-cta reset-below-btn">
    Need an account?
    <a
      class="nav-link cursor-pointer block !w-full"
      href="javascript:void(0);"
      id="signup"
      data-tab="tab-2"
      role="tab"
      aria-controls="pills-profile2"
      data-title="Create an Account"
      aria-selected="false"
      >Sign Up</a
    >
  </div>
  {%- if shop.checkout.guest_login -%}
    <div>
      <hr>
      <h2>Continue as a guest</h2>

      {%- form 'guest_login' -%}
        <button
          class="brown-btn !my-20 w-fit font-body !pt-10 !pb-7 !px-20 !font-semibold !bg-brown !text-white !border !border-solid !border-brown !rounded-4 !text-16 !leading-26 !tracking-normal text-center flex flex-col items-center capitalize cursor-pointer transition-all duration-300 ease-in-out relative hover:!bg-transparent hover:!text-brown"
        >
          Continue
        </button>
      {%- endform -%}
    </div>
  {%- endif -%}
</div>
